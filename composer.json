{
    "name": "super-kernel/context",
    "description": "Application container and transparent execution-scope context for SuperKernel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "psr/container": "^2.0.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.5"
    },
    "conflict": {
        "ext-swoole": "<6.2.3 || >=6.3"
    },
    "suggest": {
        "ext-swoole": "Provides the Swoole coroutine and thread context services (>=6.2.3 <6.3).",
        "super-kernel/di": "Provides automatic application-container initialization when getContainer() is first called."
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\Context\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernel\\Context\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "test": "@php vendor/bin/phpunit"
    }
}
